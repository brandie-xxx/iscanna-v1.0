# GEMINI_API_KEY: Required. Server-side key for Gemini vision OCR.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Gemini model used for OCR (default: gemini-3.6-flash).
# GEMINI_MODEL="gemini-3.6-flash"

# PORT: Optional. HTTP port (default: 3000).
# PORT=3000

# TRUST_PROXY_HOPS: Optional. Number of reverse proxies in front of the server,
# so per-IP rate limiting uses the real client address.
# TRUST_PROXY_HOPS=1
